{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "predev": "node scripts/ensure-database.mjs",
    "dev": "next dev",
    "predev:webpack": "node scripts/ensure-database.mjs",
    "dev:webpack": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node scripts/e2e/review-flow.mjs",
    "perf:baseline": "node scripts/performance-baseline.mjs",
    "typecheck": "tsc --noEmit",
    "clean:next": "rm -rf .next",
    "postinstall": "prisma generate && npm run sudachi:setup",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:push": "prisma db push --config prisma.config.ts",
    "user:claim": "node scripts/claim-user.mjs",
    "user:create": "node scripts/create-user.mjs",
    "user:password": "node scripts/reset-user-password.mjs",
    "db:import:red-book": "node scripts/import-red-book-vocabulary.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "sudachi:setup": "node scripts/setup-sudachi.mjs && npm run sudachi:build",
    "sudachi:benchmark": "node scripts/sudachi-benchmark.mjs",
    "sudachi:build": "npm --prefix modules/language/native run build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mimiflow/sudachi": "file:modules/language/native",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "archiver": "^8.0.0",
    "dotenv": "^17.4.2",
    "jszip": "^3.10.1",
    "katex": "^0.18.4",
    "lucide-react": "^1.41.0",
    "next": "^16.3.3",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "playwright-core": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "ts-fsrs": "^5.4.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/archiver": "^8.0.0",
    "@types/node": "^26.4.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
